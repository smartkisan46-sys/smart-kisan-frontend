# =========================================================================
# SMART KISAN — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env` (never commit `.env` to Git) or enter these keys
# directly in the "⚙️ API & Cloud Setup" modal inside the website.
# =========================================================================

# 1. Supabase Configuration (Public publishable anon key ONLY — NEVER use service_role key!)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# 2. Optional Weather & Mandi API Keys
# Note: Open-Meteo works out-of-the-box for live weather without any API key!
VITE_OPENWEATHER_API_KEY=
VITE_DATA_GOV_IN_AGMARKNET_API_KEY=
